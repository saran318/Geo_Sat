# Streamlit Secrets — DO NOT COMMIT THIS FILE
# Add this file to .gitignore
# For Streamlit Cloud: add these keys under App Settings → Secrets

[copernicus]
username = "your_copernicus_username"
password = "your_copernicus_password"

[gee]
service_account = "your_gee_service_account@project.iam.gserviceaccount.com"
# Paste the full JSON key content below (multi-line string)
# key_json = """{ ... }"""

[model]
# Direct download link for model weights hosted on GitHub Releases
weights_url = "https://github.com/YOUR_USERNAME/geo_sat_project/releases/download/v1.0.0/resnet50_best.pt"
